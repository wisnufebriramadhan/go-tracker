[Unit]
Description=Go Tracker Flask application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/go-tracker/app
EnvironmentFile=/opt/go-tracker/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/go-tracker/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8000 --timeout 60 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
