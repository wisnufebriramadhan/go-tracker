[Unit]
Description=Go Tracker Flask application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/go-tracker/app
EnvironmentFile=/opt/go-tracker/.env
Environment=PYTHONUNBUFFERED=1
# SSE keeps dashboard connections open. Threads let other requests continue,
# while timeout 0 prevents Gunicorn from killing healthy SSE streams.
ExecStart=/opt/go-tracker/venv/bin/gunicorn --worker-class gthread --workers 1 --threads 8 --bind 127.0.0.1:8010 --timeout 0 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
